<idea-plugin>
    <id>com.sohocn.serialVersionUid</id>
    <name>SerialVersionUID Generator</name>
    <vendor email="215241062@qq.com">龙江湖</vendor>
    <description><![CDATA[自动为实现Serializable接口的类生成serialVersionUID]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="SerialVersionUID Generator" displayType="BALLOON" />
        <completion.contributor language="JAVA"
                                implementationClass="com.sohocn.serialVersionUid.completion.SerialVersionUIDCompletionContributor"/>
        <intentionAction>
            <className>com.sohocn.serialVersionUid.intention.GenerateSerialVersionUIDIntention</className>
            <category>Serialization</category>
        </intentionAction>
    </extensions>

    <actions>
        <action id="com.sohocn.serialVersionUid.GenerateSerialVersionUID"
                class="com.sohocn.serialVersionUid.action.GenerateSerialVersionUIDAction"
                text="SerialVersionUID"
                description="Generate serialVersionUID for Serializable class">
            <add-to-group group-id="GenerateGroup" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>